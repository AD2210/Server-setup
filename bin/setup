#!/usr/bin/env bash

## ============================================================================
## Server Setup
## Orchestrateur principal - compatible interactif / unattended
## ============================================================================

set -euo pipefail

# ----------------------------------------------------------------------------
# Résolution du chemin réel du projet
# ----------------------------------------------------------------------------

SOURCE="${BASH_SOURCE[0]}"

while [ -h "$SOURCE" ]; do
    DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done

PROJECT_DIR="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"

# ----------------------------------------------------------------------------
# Librairies
# ----------------------------------------------------------------------------

source "$PROJECT_DIR/lib/log.sh"
source "$PROJECT_DIR/lib/config.sh"
source "$PROJECT_DIR/lib/prompt.sh"
source "$PROJECT_DIR/lib/utils.sh"
source "$PROJECT_DIR/lib/system.sh"

# ----------------------------------------------------------------------------
# Arguments
# ----------------------------------------------------------------------------

COMMAND=""
ARG_CONFIG=""
ARG_SECRETS=""

usage() {
    log ""
    log "Usage : sudo setup <commande> [options]"
    log ""
    log "Commandes disponibles :"
    log "  all, install             Exécute les modules installables dans l'ordre"
    log "  system                   Prépare le système et les dépendances APT"
    log "  security                 Configure l'utilisateur admin, SSH et UFW"
    log "  security-deluser         Supprime l'utilisateur initial (hors all)"
    log "  docker                   Installe Docker, Compose et le runtime release"
    log "  reverse-proxy, proxy     Installe le socle serveur Caddy"
    log "  backup                   Configure les sauvegardes et timers"
    log "  restore                  Restaure une DB, des fichiers ou une release"
    log "  logrotate, logs          Configure la rotation des logs"
    log "  updates, update          Configure les mises à jour automatiques"
    log "  reboot                   Configure le redémarrage périodique"
    log "  monitoring, healthcheck  Installe Ember et Vector"
    log "  finalize, check          Vérifie l'état final du serveur"
    log ""
    log "Options :"
    log "  --config FILE          Charge une configuration"
    log "  --secrets FILE         Charge les secrets depuis un fichier root-only"
    log "  --non-interactive      Interdit toute saisie interactive"
    log "  -h, --help             Affiche l'aide"
    log ""
    log "Exemples :"
    log "  sudo setup security"
    log "  sudo setup all --config ./setup.conf"
    log "  sudo setup all --config ./setup.conf --secrets ./secrets.conf --non-interactive"
    log ""
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --config)
            [ "$#" -ge 2 ] || {
                log_error "--config nécessite un fichier."
                exit 1
            }
            ARG_CONFIG="$2"
            shift 2
            ;;
        --secrets)
            [ "$#" -ge 2 ] || {
                log_error "--secrets nécessite un fichier."
                exit 1
            }
            ARG_SECRETS="$2"
            shift 2
            ;;
        --non-interactive)
            NON_INTERACTIVE=true
            shift
            ;;
        -h | --help)
            usage
            exit 0
            ;;
        -*)
            log_error "Option inconnue : $1"
            exit 1
            ;;
        *)
            if [ -z "$COMMAND" ]; then
                COMMAND="$1"
                shift
            else
                log_error "Argument inattendu : $1"
                exit 1
            fi
            ;;
    esac
done

# ----------------------------------------------------------------------------
# Exécution des modules
# ----------------------------------------------------------------------------

run_module() {
    local module="$1"
    local module_file="$PROJECT_DIR/modules/$module/install.sh"

    [ -f "$module_file" ] || {
        log_error "Module introuvable : $module"
        return 1
    }

    (
        # shellcheck disable=SC1090
        source "$module_file"
    )
}

run_all_modules() {
    local module_dir module_name

    for module_dir in "$PROJECT_DIR"/modules/*; do
        [ -d "$module_dir" ] || continue
        [ -f "$module_dir/install.sh" ] || continue

        module_name="$(basename "$module_dir")"

        case "$module_name" in
            11_security_deluser | 41_restore)
                continue
                ;;
        esac

        run_module "$module_name"
    done
}

# ----------------------------------------------------------------------------
# Préflight
# ----------------------------------------------------------------------------

log_module "Initialisation de Server Setup"

require_root
require_ubuntu_lts
require_project_structure "$PROJECT_DIR"

init_config "$ARG_CONFIG" "$ARG_SECRETS"

wait_for_apt \
    "$(config_get APT_WAIT_TIMEOUT 600)" \
    "$(config_get APT_WAIT_INTERVAL 5)" ||
    exit 1

if $NON_INTERACTIVE; then
    log_info "Mode non interactif activé."
fi

# ----------------------------------------------------------------------------
# Routing
# ----------------------------------------------------------------------------

case "${COMMAND:-}" in
    all | install)
        run_all_modules
        ;;
    system)
        run_module "00_system"
        ;;
    security)
        run_module "10_security"
        ;;
    security-deluser)
        run_module "11_security_deluser"
        ;;
    docker)
        run_module "20_docker"
        ;;
    proxy | reverse-proxy)
        run_module "30_reverse_proxy"
        ;;
    backup)
        run_module "40_backup"
        ;;
    restore)
        run_module "41_restore"
        ;;
    logrotate | logs)
        run_module "50_logrotate"
        ;;
    updates | update)
        run_module "60_updates"
        ;;
    reboot)
        run_module "70_reboot"
        ;;
    healthcheck | monitoring)
        run_module "80_monitoring"
        ;;
    finalize | check)
        run_module "90_finalize"
        ;;
    help | "")
        usage
        ;;
    *)
        log_error "Commande inconnue : $COMMAND"
        usage
        exit 1
        ;;
esac
