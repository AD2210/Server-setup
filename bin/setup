#!/usr/bin/env bash
set -e

# Résout le chemin réel même avec symlink
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
BASE_DIR="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"

source "$BASE_DIR/lib/log.sh"
source "$BASE_DIR/lib/utils.sh"

load_env

run_all_modules() {
  for module in "$BASE_DIR/modules/"*; do
    run_module "$(basename "$module")"
  done
}

run_module() {
  local module="$1"
  log_info "Running module: $module"
  bash "$BASE_DIR/modules/$module/install.sh"
}

case "$1" in
  all|install) run_all_modules ;;
  system) run_module "00_system" ;;
  security) run_module "10_security" ;;
  docker) run_module "20_docker" ;;
  proxy) run_module "30_reverse_proxy" ;;
  backup) run_module "40_backup" ;;
  *) echo "Usage: setup {all|system|security|docker|proxy|backup}" ;;
esac
