# Vector - Server Setup
# Les sinks utilisent des URLs séparées afin de permettre un routage par type
# de journal lorsque l'API centrale sera finalisée.

[sources.system_journal]
type = "journald"
include_units = ["caddy.service", "docker.service", "ssh.service", "fail2ban.service", "vector.service"]

[sources.docker]
type = "docker_logs"

[sources.symfony]
type = "file"
include = ["/srv/apps/*/var/log/*.log"]
read_from = "end"

[transforms.system_json]
type = "remap"
inputs = ["system_journal"]
source = '''
original = .
.instance = {"server": get_env_var!("VECTOR_INSTANCE")}
.timestamp_utc = now()
.log_type = "journal"
.from = null
.to = null
.log = original
'''

[transforms.docker_json]
type = "remap"
inputs = ["docker"]
source = '''
original = .
.instance = {"server": get_env_var!("VECTOR_INSTANCE")}
.timestamp_utc = now()
.log_type = "docker"
.from = null
.to = null
.log = original
'''

[transforms.symfony_json]
type = "remap"
inputs = ["symfony"]
source = '''
original = .
.instance = {"server": get_env_var!("VECTOR_INSTANCE")}
.timestamp_utc = now()
.log_type = "symfony"
.from = null
.to = null
if exists(.file) {
  parsed, err = parse_regex(.file, r'/srv/apps/(?P<app>[^/]+)/')
  if err == null {
    .instance.app = parsed.app
  }
}
.log = original
'''

[sinks.system_monitoring]
type = "http"
inputs = ["system_json"]
uri = "${VECTOR_JOURNAL_LOG_ENDPOINT}"
method = "post"
encoding.codec = "json"
request.headers.Content-Type = "application/json"
request.headers."X-Client-ID" = "${VECTOR_CLIENT_ID}"
request.headers."X-Client-Secret" = "${VECTOR_CLIENT_SECRET}"

[sinks.docker_monitoring]
type = "http"
inputs = ["docker_json"]
uri = "${VECTOR_DOCKER_LOG_ENDPOINT}"
method = "post"
encoding.codec = "json"
request.headers.Content-Type = "application/json"
request.headers."X-Client-ID" = "${VECTOR_CLIENT_ID}"
request.headers."X-Client-Secret" = "${VECTOR_CLIENT_SECRET}"

[sinks.symfony_monitoring]
type = "http"
inputs = ["symfony_json"]
uri = "${VECTOR_SYMFONY_LOG_ENDPOINT}"
method = "post"
encoding.codec = "json"
request.headers.Content-Type = "application/json"
request.headers."X-Client-ID" = "${VECTOR_CLIENT_ID}"
request.headers."X-Client-Secret" = "${VECTOR_CLIENT_SECRET}"
